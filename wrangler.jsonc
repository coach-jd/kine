{
  // Publicación en Cloudflare Workers: sirve la carpeta dist como sitio estático.
  // Solo los enlaces para compartir (/c/...) pasan por el código de worker/.
  "name": "kine",
  "compatibility_date": "2026-09-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/c/*"]
  }
}
